# Environment Configuration Template
ENVIRONMENT=production

# Application Secrets (CHANGE IN PRODUCTION)
SECRET_KEY=super-secret-production-key-change-me-redteam-2026
JWT_SECRET=jwt-signing-secret-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=redteam_user
POSTGRES_PASSWORD=redteam_secure_pass
POSTGRES_DB=redteam_db
DATABASE_URL=postgresql://redteam_user:redteam_secure_pass@localhost:5432/redteam_db

# Local Ollama AI Engine
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
EMBEDDING_MODEL=nomic-embed-text

# Rate Limiting & Limits
RATE_LIMIT_PER_MINUTE=120
AI_RATE_LIMIT_PER_MINUTE=30
